{
  "opencollection": "1.0.0",
  "info": {
    "name": "Privy REST Users API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get a user by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.privy.io/v1/users/:user_id",
            "headers": [
              {
                "name": "privy-app-id",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "user_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a Privy user object, including linked accounts, MFA methods, and metadata."
        }
      ]
    }
  ],
  "bundled": true
}